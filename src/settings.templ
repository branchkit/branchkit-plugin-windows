package main

templ WindowsSettings(commands []commandRow) {
	<div id="settings-table-container" class="settings-table">
		<div class="table-header" style="grid-template-columns: 1fr 1fr;">
			<div>Voice Command</div>
			<div style="text-align: right;">Action</div>
		</div>
		for _, cmd := range commands {
			<div class="settings-row" style="grid-template-columns: 1fr 1fr;">
				<div class="label">{ cmd.Phrase }</div>
				<div style="text-align: right; opacity: 0.7;">{ cmd.Description }</div>
			</div>
		}
	</div>
}
