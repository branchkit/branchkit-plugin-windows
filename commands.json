[
  {
    "pattern": [["mission", "show windows", "overview"]],
    "action": { "type": "input.shortcut", "code": 126, "modifiers": ["ctrl"] },
    "category": "Windowing"
  },
  {
    "pattern": ["next", "window"],
    "action": { "type": "input.shortcut", "code": 50, "modifiers": ["cmd"] },
    "category": "Windowing"
  },

  {
    "pattern": ["snap"],
    "category": "Snap Mode",
    "sets_tags": ["plugin.windows.snap_mode"]
  },

  {
    "pattern": ["left"],
    "action": { "type": "windows.snap", "position": "left" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },
  {
    "pattern": ["right"],
    "action": { "type": "windows.snap", "position": "right" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },
  {
    "pattern": [["full", "maximize"]],
    "action": { "type": "windows.snap", "position": "maximize" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },
  {
    "pattern": ["center"],
    "action": { "type": "windows.snap", "position": "center" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },
  {
    "pattern": ["next"],
    "action": { "type": "windows.snap", "position": "next" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },
  {
    "pattern": ["previous"],
    "action": { "type": "windows.snap", "position": "prev" },
    "category": "Snap Mode",
    "requires_tags": ["plugin.windows.snap_mode"],
    "sets_tags": ["plugin.windows.snap_mode"]
  },

  {
    "pattern": [["send", "throw", "move"], "desk", "<number>"],
    "action": { "type": "windows.move_to_space", "space": "{0}" },
    "category": "Windowing"
  },
  {
    "pattern": [["send", "throw", "move"], "tab", "desk", "<number>"],
    "action": { "type": "windows.tab_to_space", "space": "{0}" },
    "category": "Windowing"
  },
  {
    "pattern": [["send", "throw", "move"], "tab", "window", "<number>"],
    "action": { "type": "windows.tab_to_window", "index": "{0}" },
    "category": "Windowing"
  },

  {
    "pattern": [["desk", "desktop"]],
    "category": "Desk Mode",
    "sets_tags": ["plugin.windows.desk_mode"]
  },

  {
    "pattern": ["<number>"],
    "action": { "type": "windows.desk_switch", "space": "{0}" },
    "category": "Desk Mode",
    "requires_tags": ["plugin.windows.desk_mode"],
    "sets_tags": ["plugin.windows.desk_mode"]
  },
]
