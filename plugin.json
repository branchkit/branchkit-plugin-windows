{
  "id": "windows",
  "name": "Windows",
  "privileges": [
    "windows",
    "input",
    "shell"
  ],
  "version": "1.0.0",
  "description": "Native window management \u2014 snap, move to space, switch desktops, browser tab operations. Uses built-in OS primitives without a tiling system.",
  "author": "BranchKit",
  "run": "./windows-plugin",
  "collection_data": {
    "voice_commands": "commands.json"
  },
  "action_prefix": "windows",
  "action_types": {
    "snap": {
      "label": "Snap Window",
      "fields": [
        {
          "key": "position",
          "label": "Position",
          "field_type": "enum",
          "enum_values": ["left", "right", "maximize", "center", "next", "prev"],
          "required": false
        }
      ]
    },
    "move_to_space": {
      "label": "Move Window to Space",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "tab_to_space": {
      "label": "Move Browser Tab to Space",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "tab_to_window": {
      "label": "Move Browser Tab to Window",
      "fields": [
        {
          "key": "index",
          "label": "Window Index",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        }
      ]
    }
  },
  "provides": {
    "collections": {
      "plugin.windows.snap_mode": {
        "preset": "tag",
        "writers": "anyone_who_declares",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_ended",
            "_platform.discovery.closed"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Snap mode \u2014 direction words snap windows without repeating 'snap'."
      },
      "plugin.windows.desk_mode": {
        "preset": "tag",
        "writers": "anyone_who_declares",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_ended",
            "_platform.discovery.closed"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Desk mode \u2014 number words switch desktops without repeating 'desk'."
      }
    }
  },
  "consumes": {
    "collections": [
      "number"
    ]
  },
  "implements": {
    "on_action": true,
    "settings_tabs": [
      {
        "label": "Commands",
        "key": "commands"
      }
    ],
    "render_settings": true
  }
}